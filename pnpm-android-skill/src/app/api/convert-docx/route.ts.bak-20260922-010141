export async function POST(request: NextRequest) {
  try {
    // Apply SQL-based rate limiting (with Admin & Relay SHA exemption)
    const forwardedFor = request.headers.get('x-forwarded-for') || request.headers.get('x-real-ip') || ''
    const clientIp = forwardedFor.split(',')[0]?.trim() || '127.0.0.1'

    let isAdminUser = false
    try {
      const authUser = await getAuthUser()
      if (authUser) {
        isAdminUser = await isUserAdmin(authUser.id, authUser.email, authUser.user_metadata, authUser.app_metadata)
      }
    } catch {}

    const reqRelaySha = request.headers.get('x-relay-sha') || ''
    const configuredSha = process.env.RELAY_SHA
    if (configuredSha && reqRelaySha === configuredSha) {
      isAdminUser = true
    }

    const rateLimitResult = await checkRateLimit(
      clientIp,
      '/api/convert-docx',
      { maxRequests: 10, windowHours: 6 },
      { isAdmin: isAdminUser }
    )
    
    if (!rateLimitResult.allowed) {
      return NextResponse.json(
        { 
          error: rateLimitResult.error,
          rateLimit: {
            remaining: rateLimitResult.remaining,
            resetAt: rateLimitResult.resetAt
          }
        }, 
        { 
          status: 429, 
          headers: {
            'X-RateLimit-Remaining': String(rateLimitResult.remaining),
            'X-RateLimit-Reset': String(rateLimitResult.resetAt),
            'Retry-After': String(Math.ceil((rateLimitResult.resetAt - Date.now()) / 1000))
          }
        }
      )
    }

    let rawTextFull = ''
    let fileName = 'Study Notes'
    let extractedImages: Array<{ title: string; caption?: string; dataUrl: string }> = []
    let asyncMode = false
    let deckId = ''
    const contentType = request.headers.get('content-type') || ''

    if (contentType.includes('application/json')) {
      const jsonBody = await request.json()
      rawTextFull = jsonBody.text || ''
      fileName = (jsonBody.fileName || 'Study Notes').toLowerCase()
      extractedImages = Array.isArray(jsonBody.images) ? jsonBody.images : []
      asyncMode = jsonBody.async_mode === true
      deckId = jsonBody.deckId || jsonBody.deck_id || ''
    } else {
      const formData = await request.formData()
      const file = formData.get('file') as File | null
      const deepOcr = formData.get('deepOcr') === 'true'
      asyncMode = formData.get('async_mode') === 'true'
      deckId = (formData.get('deckId') || formData.get('deck_id') || '') as string
      if (!file) {
        return NextResponse.json({ error: 'No file provided' }, { status: 400 })
      }
      if (file.size > 1 * 1024 * 1024) {
        return NextResponse.json({ error: `File "${file.name}" exceeds the 1MB limit. Each file must be 1MB or less.` }, { status: 400 })
      }

      fileName = file.name.toLowerCase()
      const isTextFile = fileName.endsWith('.txt')
      const isPdfOrPpt = fileName.endsWith('.pdf') || fileName.endsWith('.pptx') || fileName.endsWith('.ppt')

      if (isPdfOrPpt) {
        const arrayBuffer = await file.arrayBuffer()
        const buffer = Buffer.from(arrayBuffer)
        const ext = path.extname(fileName)
        const tempPath = path.join(os.tmpdir(), `stitch_${Date.now()}_${Math.random().toString(36).slice(2)}${ext}`)
        fs.writeFileSync(tempPath, buffer)

        try {
          const scriptPath = path.join(/*turbopackIgnore: true*/ process.cwd(), 'scripts', 'doc_ppt_pdf_transcriber.py')
          const pythonBin = getPythonBinary()
          const rawOutput = await new Promise<string>((resolve, reject) => {
            const pyArgs = ['--json', tempPath]
            if (deepOcr) pyArgs.unshift('--deep-ocr')
            const py = spawn(pythonBin, [scriptPath, ...pyArgs])
            let out = ''
            let err = ''
            py.stdout.on('data', (d) => { out += d.toString() })
            py.stderr.on('data', (d) => { err += d.toString() })
            py.on('close', (code) => {
              if (code === 0 && out.trim()) {
                resolve(out.trim())
              } else {
                reject(new Error(err || `Transcriber exited with code ${code}`))
              }
            })
            py.on('error', (e) => reject(e))
          })

          try {
            const parsedJson = JSON.parse(rawOutput)
            rawTextFull = parsedJson.text || ''
            extractedImages = parsedJson.images || []
          } catch {
            rawTextFull = rawOutput
          }
        } finally {
          try { fs.unlinkSync(tempPath) } catch (e) {}
        }
      } else if (isTextFile) {
        rawTextFull = await file.text()
      } else {
        const arrayBuffer = await file.arrayBuffer()
        const buffer = Buffer.from(arrayBuffer)
        let imgIndex = 0
        try {
          const result = await mammoth.convertToHtml(
            { buffer },
            {
              convertImage: mammoth.images.imgElement(async (img) => {
                try {
                  const imgBuffer = await img.read()
                  const mime = img.contentType || 'image/jpeg'
                  if (imgBuffer.length > 3000) {
                    imgIndex++
                    const b64 = imgBuffer.toString('base64')
                    extractedImages.push({
                      title: `Document Figure ${imgIndex}`,
                      caption: `Extracted from ${file.name}`,
                      dataUrl: `data:${mime};base64,${b64}`,
                    })
                  }
                } catch {}
                return { src: '' }
              }),
            }
          )
          rawTextFull = result.value
            .replace(/\s*<\/(p|div|h[1-6]|li|tr|th|td)>/gi, '\n')
            .replace(/<[^>]+>/g, '')
        } catch {
          const result = await mammoth.extractRawText({ buffer })
          rawTextFull = result.value
        }
      }
    }

    const rawText = rawTextFull.replace(/\s+/g, ' ').trim()

    if (!rawText) {
      return NextResponse.json({ error: 'Could not extract text from file' }, { status: 400 })
    }

    // CSV passthrough
    const firstLine = rawTextFull.split(/\r?\n/).find((l: string) => l.trim())?.trim() ?? ''
    if (/^front[,\t]/.test(firstLine) && /type/.test(firstLine)) {
      const csvLines = rawTextFull
        .replace(/^\uFEFF/, '')
        .split(/\r?\n/)
        .map((l: string) => l.trim())
        .filter(Boolean)
        .join('\n')
      return new NextResponse(csvLines, {
        status: 200,
        headers: { 'Content-Type': 'text/csv; charset=utf-8' },
      })
    }

    let rows: FlashcardRow[] = []

    // 1. Primary AI Pipeline: Chrome Extension Relay (Gemini Flash Pro web bridge)
    try {
      console.log('[convert-docx] Enqueuing job to Chrome Extension Relay Queue (Gemini Flash)...')
      const topicName = fileName.replace(/\.[^/.]+$/, '').replace(/[_-]+/g, ' ').trim()
      
      const relayPrompt = `Analyze the entire reference material.
Identify every distinct topic and subtopic.
Extract every examinable fact, including definitions, formulas, theories, processes, rules, exceptions, examples, and conditions.
Merge duplicate facts but NEVER omit unique information.

VOLUME & GENERATION ORDER (MANDATORY PRIORITY):
1. NOTES FIRST:
   • Extract comprehensive "keyword" rows for the Notes tab first (bolding ONLY the leading term name).
   • Tables, comparison matrices, and datasets MUST ONLY be generated as "keyword" rows using &[TABLE: Header 1, Header 2 | Row 1 Col 1, Row 1 Col 2]. NEVER put tables in flashcards.

2. MATH & CODE CHALLENGES PRIORITY (GENERATE FIRST BEFORE REGULAR CARDS):
   • IF mathematics or physics formulas are present:
     - Generate type="math" or "math_problem" rows FIRST.
     - Populate math_problem (LaTeX), math_answer, math_category, math_difficulty, and math_steps (pipe-delimited tuples: "latex|explanation|operationType|badge ; ...").
   • IF programming, Computer Science, or SQL is present:
