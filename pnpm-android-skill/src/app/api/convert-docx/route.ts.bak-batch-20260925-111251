const CSV_HEADERS = [
  'front', 'back', 'chapter', 'subject', 'lesson', 'type',
  'mc_correct', 'mc_distractor1', 'mc_distractor2', 'mc_distractor3',
  'tf_answer', 'enum_items', 'id_answer', 'id_variants',
]

function escapeCSV(value: string): string {
  if (value.includes(',') || value.includes('"') || value.includes('\n')) {
    return `"${value.replace(/"/g, '""')}"`
  }
  return value
}

function rowsToCSV(rows: FlashcardRow[]): string {
  const header = CSV_HEADERS.join(',')
  const lines = rows.map((row) =>
    CSV_HEADERS.map((h) => escapeCSV(row[h as keyof FlashcardRow] ?? '')).join(',')
  )
  return [header, ...lines].join('\n')
}

function makeRow(overrides: Partial<FlashcardRow>): FlashcardRow {
  return {
    front: '', back: '', chapter: '', subject: '', lesson: '',
    type: 'definition',
    mc_correct: '', mc_distractor1: '', mc_distractor2: '', mc_distractor3: '',
    tf_answer: '', enum_items: '', id_answer: '', id_variants: '',
    ...overrides,
  }
}

interface ParsedCard {
  front: string
  back: string
  subject: string
  topic: string
  type: string
}

function isCodeOrNoise(text: string): boolean {
  const t = text.trim()
  if (!t || t.length < 2) return true
  // Check for programming code fragments
  if (
    /^(const|let|var|function|return|import|export|console\.|document\.|for\s*\(|while\s*\(|if\s*\(|\/\/|\/\*|<\/?script)/i.test(t) ||
    /^(key|value|properties|values|direction|syntax|example|e\.g|note|output|activity\s*\d*|direction\s*:?)$/i.test(t) ||
    /[{};=><\[\]]/.test(t) ||
    t.startsWith('"') && t.endsWith('",') ||
    t.startsWith("'") && t.endsWith("',")
  ) {
    return true
  }
  return false
}

function cleanSlideHeader(header: string, lines: string[]): { title: string; remainingLines: string[] } {
  let title = header.replace(/^(\d+[\.\)]|[•\-\*])\s*/, '').trim()
  let remainingLines = lines.slice(1).filter((l) => l.trim().length > 0)

  // If header is a slide marker (e.g. === Slide 10 - JS Functions === or === Slide 10 ===)
  if (/^===?\s*Slide\s*\d+/i.test(title) || title.startsWith('===')) {
    // Extract title from marker if present (e.g. Slide 10 - JavaScript Functions)
    const markerTitleMatch = title.match(/^===?\s*Slide\s*\d+\s*(?:[-–—:]\s*(.+?))?\s*===?$/i)
    if (markerTitleMatch && markerTitleMatch[1] && markerTitleMatch[1].trim().length > 2) {
      title = markerTitleMatch[1].trim().replace(/^[•\-\*]\s*/, '')
    } else if (remainingLines.length > 0) {
      // Use the first non-empty content line as the real slide title
      title = remainingLines[0].replace(/^(\d+[\.\)]|[•\-\*])\s*/, '').trim()
      remainingLines = remainingLines.slice(1)
    } else {
      title = 'Presentation Notes'
    }
  }

  // Clean trailing punctuation or marker syntax
  title = title.replace(/^===+|===+$/g, '').trim()
  return { title: title || 'Topic', remainingLines }
}

function parseStructuredNotes(rawText: string): ParsedCard[] {
  const cards: ParsedCard[] = []
  const seenFronts = new Set<string>()

  // Split by slide boundaries, horizontal rules, or double newlines
  const rawSections = rawText
    .split(/(?:_{3,}|-{3,}|\n{2,}|(?====\s*Slide\s*\d+))/i)
    .map((s) => s.trim())
    .filter(Boolean)

  for (const section of rawSections) {
    const rawLines = section.split(/\r?\n/).map((l) => l.trim()).filter(Boolean)
    if (rawLines.length === 0) continue

    const { title: header, remainingLines: contentLines } = cleanSlideHeader(rawLines[0], rawLines)
    if (!header || isCodeOrNoise(header)) continue

    const allSectionLines = contentLines.length > 0 ? contentLines : rawLines.slice(1)

    // 1. Create a rich study note card for Notes tab (deduped by title)
    if (allSectionLines.length > 0 && !seenFronts.has(header.toLowerCase())) {
      const combinedNotes = allSectionLines
        .map((l) => (l.startsWith('•') || l.startsWith('-') ? l : `• ${l}`))
        .join('\n')

      cards.push({
        front: header,
        back: combinedNotes,
        subject: header,
        topic: 'Notes',
        type: 'keyword',
      })
      seenFronts.add(header.toLowerCase())
    }

    // 2. Extract clean flashcards from definitions and key concepts
    for (const line of allSectionLines) {
      const cleanLine = line.replace(/^(\d+[\.\)]|[•\-\*])\s*/, '').trim()
      if (!cleanLine || isCodeOrNoise(cleanLine) || cleanLine.length < 5) continue

      let key = ''
      let val = ''

      // Structured delimiters: em-dash (—), en-dash (–), hyphen ( - ), or colon (:)
      if (cleanLine.includes('—')) {
        const parts = cleanLine.split('—')
        key = parts[0].trim()
        val = parts.slice(1).join('—').trim()
      } else if (cleanLine.includes('–')) {
        const parts = cleanLine.split('–')
        key = parts[0].trim()
        val = parts.slice(1).join('–').trim()
      } else if (cleanLine.includes(' - ')) {
        const parts = cleanLine.split(' - ')
        key = parts[0].trim()
        val = parts.slice(1).join(' - ').trim()
      } else if (cleanLine.includes('\t')) {
        const parts = cleanLine.split('\t').map((p) => p.trim()).filter(Boolean)
        if (parts.length >= 2) {
          key = parts[0]
          val = parts.slice(1).join(' — ')
        }
      } else if (cleanLine.includes(':')) {
        const colonIdx = cleanLine.indexOf(':')
        if (colonIdx > 0 && colonIdx < 40) {
          const candidateKey = cleanLine.slice(0, colonIdx).trim()
          const candidateVal = cleanLine.slice(colonIdx + 1).trim()
          // Only accept clean term: definition pairs (no code, no quotes, no operators)
          if (!isCodeOrNoise(candidateKey) && !isCodeOrNoise(candidateVal) && !candidateKey.includes('"')) {
            key = candidateKey
            val = candidateVal
          }
        }
      }

      // Check for clean term: definition match
      if (key && val && !isCodeOrNoise(key) && !isCodeOrNoise(val) && val.length > 3) {
        const frontText =
          key.toLowerCase().includes(header.toLowerCase()) || header.length < 3 || key.length > 25
            ? key
            : `${header}: ${key}`

        const frontKey = frontText.toLowerCase()
        if (!seenFronts.has(frontKey)) {
          cards.push({
            front: frontText,
            back: val,
            subject: header,
            topic: key,
            type: 'definition',
          })
          seenFronts.add(frontKey)
        }
        continue
      }

      // Check for natural language definition statements ("X is a Y", "X refers to Y")
      if (!cleanLine.endsWith('?')) {
        const defMatch = cleanLine.match(/^([A-Z][A-Za-z0-9\s_-]{2,35})\s+(?:is|are|refers to|defined as)\s+(.+)/i)
        if (
          defMatch &&
          !isCodeOrNoise(defMatch[1]) &&
          !/^(what|why|how|when|where|who|which|there|it|this|these|they|that)\b/i.test(defMatch[1]) &&
          defMatch[2].length > 8
        ) {
          const term = defMatch[1].trim()
          const definition = defMatch[2].replace(/[.!?]$/, '').trim()
          const frontKey = term.toLowerCase()
          if (!seenFronts.has(frontKey)) {
            cards.push({
              front: term,
              back: `${term} is ${definition}.`,
              subject: header,
              topic: term,
              type: 'definition',
            })
            seenFronts.add(frontKey)
          }
        }
      }
    }
  }

  return cards
}

function parseTextToCards(rawText: string): ParsedCard[] {
  // Check if input has structured notes (em-dashes —, bullets, colons, numbers, or line breaks)
  if (
    rawText.includes('—') ||
    rawText.includes('–') ||
    rawText.includes('•') ||
    rawText.includes(':') ||
    rawText.includes('\t') ||
    /\d+[\.\)]\s+/.test(rawText) ||
    /_{3,}/.test(rawText) ||
    /\n/.test(rawText.trim())
  ) {
    const noteCards = parseStructuredNotes(rawText)
    if (noteCards.length > 0) return noteCards
  }

  const sentences = rawText
    .split(/(?<=[.!?])\s+/)
    .map(s => s.trim())
    .filter(s => s.length > 0)

  const PATTERNS: Record<string, RegExp> = {
    definition:  /(.+?)\s+(?:is|are|was|were)\s+(.+)/i,
    property:    /(.+?)\s+(?:has|have)\s+(.+)/i,
    function:    /(.+?)\s+(?:produces?|creates?|makes?|forms?)\s+(.+)/i,
    composition: /(.+?)\s+(?:contains?|consists? of)\s+(.+)/i,
    method:      /(.+?)\s+(?:uses?|attracts?)\s+(.+)/i,
    cause:       /(.+?)\s+(?:causes?|enables?|allows?)\s+(.+)/i,
  }

  let currentTopic: string | null = null
  const cards: ParsedCard[] = []

  for (let sentence of sentences) {
    if (currentTopic) {
      sentence = sentence
        .replace(/^It\b/i, currentTopic)
        .replace(/^They\b/i, currentTopic)
        .replace(/^This\b/i, currentTopic)
        .replace(/^These\b/i, currentTopic)
    }

    const defMatch = sentence.match(/^(?:A|An|The)\s+(.+?)\s+(?:is|are)\s+/i)
    if (defMatch) {
      currentTopic = defMatch[1].trim()
    }

    let matched = false
    for (const [type, regex] of Object.entries(PATTERNS)) {
      const m = sentence.match(regex)
      if (m) {
        const subject = m[1].replace(/^(A|An|The)\s+/i, '').trim()
        const object = m[2].replace(/[.!?]$/, '').trim()

        const blankTemplates: Record<string, string> = {
          definition:  `${subject} is ____.`,
          property:    `${subject} has ____.`,
          function:    `${subject} produces ____.`,
          composition: `${subject} contains ____.`,
          method:      `${subject} uses/attracts ____.`,
          cause:       `${subject} causes/enables ____.`,
        }

        cards.push({
          front: blankTemplates[type],
          back: object,
          subject: currentTopic || subject,
          topic: type,
          type: 'definition',
        })

        matched = true
        break
      }
    }

    if (!matched && currentTopic) {
      cards.push({
        front: `${currentTopic} ____.`,
        back: sentence.replace(/[.!?]$/, '').trim(),
        subject: currentTopic,
        topic: 'general',
        type: 'definition',
      })
    }
  }

  return cards
}

async function generateCardsWithAI(text: string): Promise<FlashcardRow[] | null> {
  const prompt = `Convert these study notes into a comprehensive, high-yield deck for StitchCSV:
MANDATORY RULES:
1. NOTES FIRST & 1-TO-1 PAIRING:
   - For every distinct concept, create a "keyword" row (for Notes tab) with rich bullet points (bolding ONLY the leading term name, e.g. "• **Term** - explanation").
   - For EVERY bullet inside a "keyword" note row's back field, generate ONE matching "definition" flashcard: front = the bullet's bolded term, back = the bullet's definition text. Never put a label like "X Definition" in the front.
2. QUIZ TYPES: Include "multiple_choice", "true_false", "enumeration", and "identification" where applicable.
2b. MATH LATEX — COMPLETE AND FULLY FORMATTED (MANDATORY): Every type="math" row MUST have valid LaTeX in math_answer AND in the 1st segment of every math_steps entry. ALWAYS include the complete expression: \\int, \\frac, \\sqrt, \\sum, \\lim, \\sin, \\cos, \\tan, \\pi, \\theta, subscripts (_{...}), superscripts (^{...}), and \\left[ ... \\right]_{a}^{b} delimiters. NEVER write plain-text shortcuts like "int", "frac", "sqrt", "sinx", or "pi". Every math_answer MUST end with a unit wrapped in \\text{...} — e.g. "\\frac{16}{3} \\text{ square units}", "5 \\text{ cm}", or "\\text{ units}" if no physical unit applies. The final step's badge (4th math_steps segment) MUST be exactly "Answer" or "Answer: <unit>".
3. DIRECTIVES & DATA PLACEMENT:
   - If math is present, use math directives like &*(sigma), &*(cos), &*(sqrt{x}), or &*(STEPS: step1 -> step2 -> step3).
   - TABLES STRICTLY IN NOTES: If tables or tabular comparisons are present, format them ONLY as "keyword" rows for the Notes tab using &[TABLE: H1, H2 | R1C1, R1C2] (never raw markdown pipes). Tables must NEVER go to flashcards (type definition, concept, etc.).
   - If coding is present, use &[CODE: python=... | java=... | js=...].

Each JSON object MUST have:
"front", "back", "type", "subject", "lesson", "mc_correct", "mc_distractor1", "mc_distractor2", "mc_distractor3", "tf_answer", "enum_items", "id_answer"

STUDY NOTES:
"""
${text.slice(0, 12000)}
"""`

  const systemPrompt = `You are a JSON API. You MUST output ONLY a valid JSON array of flashcard objects starting with [ and ending with ]. NEVER include thinking, explanations, preamble, or markdown backticks.`

  try {
    const rawOutput = await callAI(systemPrompt, prompt)
    if (!rawOutput) return null

    const jsonMatch = rawOutput.match(/\[\s*\{[\s\S]*\}\s*\]/) || rawOutput.match(/```(?:json)?\s*([\s\S]*?)\s*```/)
    const jsonStr = jsonMatch ? (jsonMatch[1] || jsonMatch[0]) : rawOutput.trim()

    const parsed = JSON.parse(jsonStr)
    if (Array.isArray(parsed) && parsed.length > 0) {
      console.log(`[convert-docx] Successfully generated ${parsed.length} cards via AI`)
      return parsed.map((item) => makeRow({
        front: String(item.front || '').trim(),
        back: String(item.back || '').trim(),
        subject: String(item.subject || 'General').trim(),
        lesson: String(item.lesson || 'Study Notes').trim(),
        type: String(item.type || 'definition').toLowerCase().trim(),
        mc_correct: String(item.mc_correct || '').trim(),
        mc_distractor1: String(item.mc_distractor1 || '').trim(),
        mc_distractor2: String(item.mc_distractor2 || '').trim(),
        mc_distractor3: String(item.mc_distractor3 || '').trim(),
        tf_answer: String(item.tf_answer || '').toLowerCase().trim(),
        enum_items: String(item.enum_items || '').trim(),
        id_answer: String(item.id_answer || '').trim(),
      }))
    }
  } catch (err: any) {
    console.warn('[convert-docx] AI generation failed, falling back to heuristic parser:', err.message)
  }

  return null
}

