        lesson: c.topic,
        type: c.type,
      }))
    }

    // Minimum 4 cards guarantee
    if (rows.length < 4 && rows.length > 0) {
      const sentences = rawText.split(/(?<=[.!?])\s+/).map(s => s.trim()).filter(s => s.length > 10)
      for (const s of sentences) {
