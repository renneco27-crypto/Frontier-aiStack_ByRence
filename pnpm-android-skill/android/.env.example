# Copy to .env.local (gitignored) and fill in YOUR OWN values.
# Never commit real keys. Never put SUPABASE_SERVICE_ROLE_KEY into NEXT_PUBLIC_* or the APK.

# --- App (public, safe for the client bundle) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- scripts/upload-apk.js (server-side only, used from your machine/CI) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
APK_BUCKET=latest
# APK_OBJECT_NAME=app.apk
# APK_PATH=android/app/build/outputs/apk/debug/app-debug.apk
