<script>


/* ══════════════════════════════════════════
   2. PARTICLE CANVAS — with cursor linking
══════════════════════════════════════════ */
const canvas = document.getElementById('node-canvas');
const ctx    = canvas.getContext('2d');
let W, H, particles = [];
const N = 80, D = 130;
let mx = null, my = null;

window.addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; });
window.addEventListener('mouseout',  ()  => { mx = null; my = null; });

function resize() { W = canvas.width = innerWidth; H = canvas.height = innerHeight; }
window.addEventListener('resize', resize);
resize();

class P {
    constructor() {
        this.x  = Math.random() * W; this.y  = Math.random() * H;
        this.vx = (Math.random() - .5) * .6; this.vy = (Math.random() - .5) * .6;
    }
    step() {
        this.x += this.vx; this.y += this.vy;
        if (this.x < 0 || this.x > W) this.vx *= -1;
        if (this.y < 0 || this.y > H) this.vy *= -1;
    }
    draw() {
        ctx.beginPath(); ctx.arc(this.x, this.y, 1.5, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,.7)'; ctx.fill();
    }
}

for (let i = 0; i < N; i++) particles.push(new P());

(function loop() {
    ctx.clearRect(0, 0, W, H);
    for (let i = 0; i < N; i++) {
        particles[i].step();
        particles[i].draw();
        // node-to-node lines
        for (let j = i + 1; j < N; j++) {
            const dx = particles[i].x - particles[j].x;
            const dy = particles[i].y - particles[j].y;
            const d  = Math.hypot(dx, dy);
            if (d < D) {
                ctx.beginPath(); ctx.lineWidth = .5;
                ctx.strokeStyle = `rgba(255,255,255,${1 - d / D})`;
                ctx.moveTo(particles[i].x, particles[i].y);
                ctx.lineTo(particles[j].x, particles[j].y);
                ctx.stroke();
            }
        }
        // cursor-to-node lines
        if (mx !== null) {
            const dx = particles[i].x - mx;
            const dy = particles[i].y - my;
            const d  = Math.hypot(dx, dy);
            if (d < 150) {
                ctx.beginPath(); ctx.lineWidth = .8;
                ctx.strokeStyle = `rgba(255,255,255,${1 - d / 150})`;
                ctx.moveTo(particles[i].x, particles[i].y);
                ctx.lineTo(mx, my);
                ctx.stroke();
            }
        }
    }
    requestAnimationFrame(loop);
})();

/* ══════════════════════════════════════════
   3. PIXEL TRANSITION
══════════════════════════════════════════ */
(function buildPixels() {
    const container = document.getElementById('pixel-transition');
    if (!container) return;
    const columns = 24, rows = 14, blocks = [];
    for (let row = 0; row < rows; row++) {
        for (let col = 0; col < columns; col++) {
            const b = document.createElement('div');
            b.classList.add('pixel-block');
            b.style.width  = `calc(${100 / columns}% + 1px)`;
            b.style.height = `calc(${100 / rows}% + 1px)`;
            b.style.left   = (col * (100 / columns)) + '%';
            b.style.top    = (row * (100 / rows)) + '%';
            const distC = Math.abs((columns / 2) - col);
            const distB = (rows - 1) - row;
            let t = (distB / rows) * .5 + (distC / (columns / 2)) * .25 + (Math.random() * .1) - .03;
            t = Math.min(Math.max(t, 0), .92);
            container.appendChild(b);
            blocks.push({ element: b, threshold: t });
        }
    }
    window.addEventListener('scroll', () => {
        const rect = container.getBoundingClientRect();
        const start = window.innerHeight, end = window.innerHeight * .05;
        let p = (start - rect.top) / (start - end);
        p = Math.max(0, Math.min(1, p));
        blocks.forEach(b => b.element.style.opacity = p > b.threshold ? '1' : '0');
    });
})();

/* ══════════════════════════════════════════
   4. GSAP CLIP-PATH PANEL TRANSITION
   (intro section: slides in from right, exits upward)
══════════════════════════════════════════ */
gsap.registerPlugin(ScrollTrigger);

function fixedOverlay(cssExtra, innerHTML) {
    const d = document.createElement('div');
    d.style.cssText = 'position:fixed;top:0;left:0;z-index:50;pointer-events:none;opacity:0;' + cssExtra;
    if (innerHTML) d.innerHTML = innerHTML;
    document.body.appendChild(d);
    return d;
}

(() => {
    const sec      = document.querySelector('.section-intro'); if (!sec) return;
    const title    = sec.querySelector('.col-main-title');
    const botMedia = sec.querySelector('.col-bottom-media');
    const botExtra = sec.querySelector('.col-bottom-extra');
    const src      = sec.querySelector('.expanding-panel-inner');

    const ov = fixedOverlay(
        'width:100vw;height:100vh;background:#0d0d0d;display:flex;' +
        'align-items:center;justify-content:flex-end;padding:5rem 6rem;' +
        'box-sizing:border-box;clip-path:inset(0 0 0 100%);',
        src ? src.innerHTML : ''
    );

    const tl = gsap.timeline({ scrollTrigger: {
        trigger: sec, start: 'top top', end: 'bottom bottom', scrub: 1.2,
        onEnter:     () => gsap.set(ov, { opacity: 1, clipPath: 'inset(0 0 0 100%)', pointerEvents: 'auto' }),
        onLeaveBack: () => gsap.set(ov, { opacity: 0, clipPath: 'inset(0 0 0 100%)', pointerEvents: 'none' }),
    }});

    tl.to(title,    { x: '-60vw', opacity: 0, ease: 'power2.in', duration: .5 }, 0);
    tl.to(botMedia, { y: '50vh',  opacity: 0, ease: 'power2.in', duration: .5 }, 0);
    tl.to(botExtra, { x: '55vw',  opacity: 0, ease: 'power2.in', duration: .5 }, .05);
    // Clip in from right
    tl.fromTo(ov, { clipPath: 'inset(0 0 0 100%)' }, { clipPath: 'inset(0 0 0 0%)',   ease: 'power3.inOut', duration: .9 }, .1);
    // Exit upward
    tl.to(ov,      { clipPath: 'inset(0% 0 100% 0)', ease: 'power3.inOut', duration: .9 }, 1.1);
    tl.from(ov.querySelectorAll('.stack-list span'),
        { y: 25, opacity: 0, stagger: .06, duration: .4, ease: 'power2.out' }, .65);
})();

/* ══════════════════════════════════════════
   5. TOS SECTION SCROLL REVEALS
══════════════════════════════════════════ */
document.querySelectorAll('.tos-section').forEach(sec => {
    gsap.to(sec, {
        scrollTrigger: { trigger: sec, start: 'top 82%', toggleActions: 'play none none none' },
        opacity: 1, y: 0, duration: .6, ease: 'power2.out',
    });
});

/* ══════════════════════════════════════════
   6. ACTIVE TOC HIGHLIGHT
══════════════════════════════════════════ */
const sections = document.querySelectorAll('.tos-section[id]');
const tocItems  = document.querySelectorAll('.toc-item');

new IntersectionObserver(entries => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            tocItems.forEach(t => t.classList.remove('active'));
            const match = document.querySelector(`.toc-item[href="#${entry.target.id}"]`);
            if (match) match.classList.add('active');
        }
    });
}, { rootMargin: '-30% 0px -60% 0px' }).observe
    ? sections.forEach(s => new IntersectionObserver(entries => {
        entries.forEach(e => {
            if (e.isIntersecting) {
                tocItems.forEach(t => t.classList.remove('active'));
                const m = document.querySelector(`.toc-item[href="#${e.target.id}"]`);
                if (m) m.classList.add('active');
            }
        });
    }, { rootMargin: '-30% 0px -60% 0px' }).observe(s))
    : null;
</script>
